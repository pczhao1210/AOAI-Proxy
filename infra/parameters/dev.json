{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "japaneast"
    },
    "containerGroupName": {
      "value": "aoai-proxy-dev"
    },
    "image": {
      "value": "alexmcr.azurecr.io/aoai-proxy:latest"
    },
    "dnsNameLabel": {
      "value": "aoai-proxy-dev"
    },
    "persistenceMode": {
      "value": "database"
    },
    "databaseName": {
      "value": ""
