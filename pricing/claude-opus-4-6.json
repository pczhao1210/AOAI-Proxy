{
  "id": "claude-opus-4-6",
  "displayName": "Claude Opus 4.6",
  "provider": "anthropic",
  "family": "claude-4",
  "modelVersion": "2026-02-05",
  "status": "preview",
  "contextWindow": 1000000,
  "maxOutputTokens": 128000,
  "hostingModes": ["anthropic"],
  "defaultHostingMode": "anthropic",
  "interfacesByHostingMode": {
    "anthropic": ["messages"]
  },
  "interfaces": ["messages"],
  "inputModalities": ["text", "image", "code"],
  "outputModalities": ["text", "code"],
  "capabilities": ["reasoning", "vision", "function-calling"],
  "protocolProfiles": {
    "messages": {
      "thinking": {
        "parameter": "thinking.type",
        "types": ["adaptive", "enabled", "disabled"],
        "default": "adaptive",
        "validation": "passthrough"
      },
      "reasoning": {
        "parameter": "output_config.effort",
        "levels": ["low", "medium", "high", "max"],
        "default": "high",
        "aliases": {
          "xhigh": "max"
        },
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "anthropic-official",
    "status": "published",
    "inputPer1mTokens": 5,
    "cachedInputPer1mTokens": 0.5,
    "outputPer1mTokens": 25
  },
  "proxyTemplate": {},
  "sources": {
    "reasoning": "https://github.com/anthropics/skills/blob/main/skills/claude-api/SKILL.md#thinking--effort-quick-reference",
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/how-to/use-foundry-models-claude#available-claude-models",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models",
    "pricing": "https://claude.com/pricing#api"
  },
  "notes": [
    "缓存读取费率已记录；TTL 缓存写入字段受支持，但本卡片的对应单价尚待来源核实，不按缺失值计为免费。",
    "Claude Opus 4.6 可在 Azure Foundry 中直接部署，但微软文档当前说明 model-router 还不支持 claude-opus-4-6。",
    "如果需要使用 4.6 系列，请直接部署 Claude 4.6，而不是通过 model-router 路由。"
  ]
}
