{
  "id": "claude-opus-5",
  "displayName": "Claude Opus 5",
  "provider": "anthropic",
  "family": "claude-5",
  "modelVersion": "2026-07-24",
  "status": "ga",
  "contextWindow": 1000000,
  "maxOutputTokens": 128000,
  "hostingModes": ["azure", "anthropic"],
  "defaultHostingMode": "azure",
  "interfacesByHostingMode": {
    "azure": ["messages"],
    "anthropic": ["messages"]
  },
  "interfaces": ["messages"],
  "inputModalities": ["text", "image", "code"],
  "outputModalities": ["text", "code"],
  "capabilities": ["reasoning", "vision", "function-calling"],
  "protocolProfiles": {
    "messages": {
      "thinking": {
        "parameter": "thinking.type",
        "types": ["adaptive", "disabled"],
        "default": "adaptive",
        "validation": "passthrough"
      },
      "reasoning": {
        "parameter": "output_config.effort",
        "levels": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "anthropic-official",
    "status": "published",
    "inputPer1mTokens": 5,
    "cachedInputPer1mTokens": 0.5,
    "outputPer1mTokens": 25
  },
  "proxyTemplate": {},
  "sources": {
    "reasoning": "https://github.com/anthropics/skills/blob/main/skills/claude-api/SKILL.md#thinking--effort-quick-reference",
    "capabilities": "https://learn.microsoft.com/azure/foundry/foundry-models/concepts/claude-models",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models",
    "pricing": "https://platform.claude.com/docs/en/about-claude/pricing"
  },
  "notes": [
    "缓存读取费率已记录；TTL 缓存写入字段受支持，但本卡片的对应单价尚待来源核实，不按缺失值计为免费。",
    "Microsoft Foundry 同时提供 Hosted on Azure 与 Hosted on Anthropic infrastructure 两种部署模式；两种模式的推理接口均为 Anthropic Messages。",
    "Claude Opus 5 支持 low、medium、high、xhigh、max effort；thinking.type 支持 adaptive，且 high 及以下可设为 disabled。"
  ]
