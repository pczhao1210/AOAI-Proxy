{
  "id": "gpt-5.5",
  "displayName": "GPT-5.5",
  "provider": "azure-openai",
  "family": "gpt-5.5",
  "modelVersion": "2026-04-24",
  "status": "ga",
  "contextWindow": 1050000,
  "maxInputTokens": 922000,
  "maxOutputTokens": 128000,
  "interfaces": ["chat/completions", "responses"],
  "defaultInterface": "responses",
  "inputModalities": ["text", "image"],
  "outputModalities": ["text"],
  "capabilities": [
    "reasoning",
    "vision",
    "function-calling",
    "structured-outputs",
    "parallel-tool-calling",
    "computer-use"
  ],
  "protocolProfiles": {
    "chat/completions": {
      "reasoning": {
        "parameter": "reasoning_effort",
        "levels": ["none", "low", "medium", "high", "xhigh"],
        "default": "medium",
        "validation": "passthrough"
      }
    },
    "responses": {
      "reasoning": {
        "parameter": "reasoning.effort",
        "levels": ["none", "low", "medium", "high", "xhigh"],
        "default": "medium",
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "openai-official",
    "status": "published",
    "tiering": {
      "basis": "inputTokensIncludingCache",
      "method": "whole-request"
    },
    "tiers": [
      {
        "id": "short <=272K",
        "contextClass": "short",
        "promptTokensBelow": 272001,
        "inputPer1mTokens": 5,
        "cachedInputPer1mTokens": 0.5,
        "outputPer1mTokens": 30
      },
      {
        "id": "long >272K",
        "contextClass": "long",
        "promptTokensAtLeast": 272001,
        "inputPer1mTokens": 10,
        "cachedInputPer1mTokens": 1,
        "outputPer1mTokens": 45
      }
    ]
  },
  "proxyTemplate": {},
  "sources": {
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-sold-directly-by-azure",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-sold-directly-by-azure#gpt-55",
    "reasoning": "https://developers.openai.com/api/docs/guides/reasoning",
    "pricing": "https://developers.openai.com/api/docs/pricing"
  },
  "notes": [
    "The administrator-confirmed whole-request policy selects the long tier only when this request's input, including cache, exceeds 272000 tokens. Exactly 272000 remains short; session totals and output length do not select the tier.",
    "The rates are OpenAI standard per-token prices, not Batch, Flex, Priority or independently verified Azure deployment prices."
  ]
}
