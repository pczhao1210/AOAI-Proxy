  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "openai-official",
    "status": "published",
    "inputPer1mTokens": 4,
    "cachedInputPer1mTokens": 0.4,
    "outputPer1mTokens": 24,
    "channels": {
      "audio": {
        "inputPer1mTokens": 32,
        "cachedInputPer1mTokens": 0.4,
        "outputPer1mTokens": 64
      },
      "image": {
        "inputPer1mTokens": 5,
        "cachedInputPer1mTokens": 0.5
      }
    }
  },
  "pricingCatalogEntry": null,
  "proxyTemplate": {
    "routes": {
      "realtime": "realtime"
    }
  },
  "sources": {
    "capabilities": "https://developers.openai.com/api/docs/models/gpt-realtime-2",
