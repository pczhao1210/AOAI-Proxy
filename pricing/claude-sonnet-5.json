{
  "id": "claude-sonnet-5",
  "displayName": "Claude Sonnet 5",
  "provider": "anthropic",
  "family": "claude-5",
  "modelVersion": "2026-06-30",
  "status": "ga",
  "contextWindow": 1000000,
  "maxOutputTokens": 128000,
  "hostingModes": ["azure", "anthropic"],
  "defaultHostingMode": "azure",
  "interfacesByHostingMode": {
    "azure": ["messages"],
    "anthropic": ["messages"]
  },
  "interfaces": ["messages"],
  "defaultInterface": "messages",
  "inputModalities": ["text", "image"],
  "outputModalities": ["text"],
  "capabilities": ["reasoning", "vision", "function-calling"],
  "protocolProfiles": {
    "messages": {
      "thinking": {
        "parameter": "thinking.type",
        "types": ["adaptive", "disabled"],
        "default": "adaptive",
        "validation": "passthrough"
      },
      "reasoning": {
        "parameter": "output_config.effort",
        "levels": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "anthropic-official",
    "status": "published",
    "inputPer1mTokens": 2,
    "cachedInputPer1mTokens": 0.2,
    "cacheWrite5mPer1mTokens": 2.5,
    "cacheWrite1hPer1mTokens": 4,
    "outputPer1mTokens": 10
  },
  "proxyTemplate": {},
  "sources": {
    "reasoning": "https://github.com/anthropics/skills/blob/main/skills/claude-api/SKILL.md#thinking--effort-quick-reference",
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-from-partners",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models",
    "modalities": "https://platform.claude.com/docs/en/models/sonnet-5/overview",
    "hosting": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models-hosting-comparison",
    "pricing": "https://platform.claude.com/docs/en/about-claude/pricing"
  },
  "notes": [
    "Anthropic cancelled the scheduled September 1, 2026 price increase; the former introductory input/output prices are now the standard prices.",
    "Anthropic's exact-model pricing table, checked 2026-10-11, publishes cache-read and both TTL-specific cache-write rates. Regional surcharges and discounts are not included.",
    "maxInputTokens has not been independently verified for this deployment; no input ceiling is inferred from contextWindow minus maxOutputTokens.",
    "Microsoft Foundry defaults to Version 2 (Hosted on Azure) when both Claude hosting versions are available; Anthropic hosting remains selectable."
  ]
}
