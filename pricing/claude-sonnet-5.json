{
  "id": "claude-sonnet-5",
  "displayName": "Claude Sonnet 5",
  "provider": "anthropic",
  "family": "claude-5",
  "modelVersion": "2026-06-30",
  "status": "ga",
  "contextWindow": 1000000,
  "maxOutputTokens": 128000,
  "hostingModes": ["azure", "anthropic"],
  "defaultHostingMode": "anthropic",
  "interfacesByHostingMode": {
    "azure": ["messages"],
    "anthropic": ["messages"]
  },
  "interfaces": ["messages"],
  "inputModalities": ["text", "image", "code"],
  "outputModalities": ["text", "image", "code"],
  "capabilities": ["reasoning", "vision", "function-calling"],
  "protocolProfiles": {
    "messages": {
      "thinking": {
        "parameter": "thinking.type",
        "types": ["adaptive", "disabled"],
        "default": "adaptive",
        "validation": "passthrough"
      },
      "reasoning": {
        "parameter": "output_config.effort",
        "levels": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "anthropic-official",
    "status": "published",
    "inputPer1mTokens": 2,
    "cachedInputPer1mTokens": 0.2,
    "outputPer1mTokens": 10
  },
  "proxyTemplate": {},
  "sources": {
    "reasoning": "https://github.com/anthropics/skills/blob/main/skills/claude-api/SKILL.md#thinking--effort-quick-reference",
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-from-partners",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models",
    "pricing": "https://platform.claude.com/docs/en/about-claude/pricing"
  },
  "notes": [
    "价格为截至 2026-08-31 的首发价；自 2026-09-01 起，输入、缓存命中输入和输出价格将调整为 3、0.3 和 15 USD 每 1M tokens。",
    "缓存读取费率已记录；TTL 缓存写入字段受支持，但本卡片的对应单价尚待来源核实，不按缺失值计为免费。"
  ]
}
