          "hd": "high"
        },
        "dropParameters": ["style", "response_format"]
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "openai-official",
    "status": "published",
    "inputPer1mTokens": 5,
    "cachedInputPer1mTokens": 1.25,
    "inputPer1kTokens": 0.005,
    "cachedInputPer1kTokens": 0.00125,
    "channels": {
      "image": {
        "inputPer1mTokens": 8,
        "cachedInputPer1mTokens": 2,
        "outputPer1mTokens": 30,
        "inputPer1kTokens": 0.008,
        "cachedInputPer1kTokens": 0.002,
        "outputPer1kTokens": 0.03
      }
    }
  },
  "pricingCatalogEntry": null,
  "proxyTemplate": {
    "id": "gpt-image-2",
    "displayName": "GPT-Image-2",
    "targetModel": "gpt-image-2",
    "capabilities": [
      "vision",
      "image-generation",
      "image-editing"
    ],
    "pricingRef": "gpt-image-2",
    "routes": {
      "*": "openai-image"
    }
  },
  "sources": {
    "capabilities": "https://developers.openai.com/api/docs/guides/image-generation",
    "pricing": "https://openai.com/api/pricing/"
  },
  "notes": [
    "OpenAI 官方公开的是按 token 分通道计费: 文本输入 5 USD/1M、缓存文本输入 1.25 USD/1M、图片输入 8 USD/1M、缓存图片输入 2 USD/1M、图片输出 30 USD/1M。",
    "OpenAI 文档说明 gpt-image-2 支持图像生成与图像编辑，并且图像输入始终按高保真处理。",
    "当前 AOAI Proxy 治理计费只支持标准 token 单价，不支持 image channel 的独立自动结算，因此 pricingCatalogEntry 保持为空，避免将图片生成请求误算为普通文本 token 成本。"
  ]
