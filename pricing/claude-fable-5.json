        "validation": "passthrough"
      },
      "reasoning": {
        "parameter": "output_config.effort",
        "levels": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "validation": "passthrough"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "anthropic-official",
    "status": "published",
    "inputPer1mTokens": 10,
    "cachedInputPer1mTokens": 1,
    "cacheWrite5mPer1mTokens": 12.5,
    "cacheWrite1hPer1mTokens": 20,
    "outputPer1mTokens": 50
  },
  "proxyTemplate": {},
  "sources": {
    "reasoning": "https://github.com/anthropics/skills/blob/main/skills/claude-api/SKILL.md#thinking--effort-quick-reference",
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-from-partners",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/claude-models",
