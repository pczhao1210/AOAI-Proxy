{
  "id": "gpt-5.1-codex-mini",
  "displayName": "GPT-5.1 Codex Mini",
  "provider": "azure-openai",
  "family": "gpt-5.1",
  "modelVersion": "2025-11-13",
  "status": "ga",
  "contextWindow": 400000,
  "maxInputTokens": 272000,
  "maxOutputTokens": 128000,
  "interfaces": ["responses"],
  "inputModalities": ["text", "image"],
  "outputModalities": ["text"],
  "capabilities": [
    "reasoning",
    "vision",
    "code-optimized",
    "function-calling",
    "structured-outputs",
    "parallel-tool-calling"
  ],
  "protocolProfiles": {
    "responses": {
      "reasoning": {
        "parameter": "reasoning.effort",
        "levels": ["low", "medium", "high"]
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "azure-openai-global",
    "status": "published",
    "inputPer1mTokens": 0.25,
    "cachedInputPer1mTokens": 0.025,
    "outputPer1mTokens": 2
  },
  "proxyTemplate": {
    "routes": {
      "*": "responses"
    }
  },
  "sources": {
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-sold-directly-by-azure",
    "limits": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/concepts/models-sold-directly-by-azure#gpt-51",
    "pricing": "https://azure.microsoft.com/en-us/pricing/details/cognitive-services/openai-service/"
  }
}
