{
  "id": "grok-4.3",
  "displayName": "Grok 4.3",
  "provider": "xai",
  "family": "grok-4.3",
  "modelVersion": null,
  "status": "preview",
  "contextWindow": 1000000,
  "interfaces": ["chat/completions", "responses"],
  "inputModalities": ["text"],
  "outputModalities": ["text"],
  "capabilities": ["reasoning", "function-calling"],
  "protocolProfiles": {
    "chat/completions": {
      "reasoning": {
        "parameter": "reasoning_effort",
        "levels": ["none", "low", "medium", "high"],
        "default": "low"
      }
    }
  },
  "pricing": {
    "currency": "USD",
    "billingUnit": "1M tokens",
    "sourceType": "xai-official",
    "status": "published",
    "tiering": {
      "basis": "inputTokensIncludingCache",
      "method": "whole-request"
    },
    "tiers": [
      {
        "id": "short",
        "promptTokensBelow": 200000,
        "inputPer1mTokens": 1.25,
        "cachedInputPer1mTokens": 0.2,
        "outputPer1mTokens": 2.5
      },
      {
        "id": "long",
        "promptTokensAtLeast": 200000,
        "inputPer1mTokens": 2.5,
        "cachedInputPer1mTokens": 0.4,
        "outputPer1mTokens": 5
      }
    ]
  },
  "proxyTemplate": {},
  "sources": {
    "capabilities": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/how-to/use-foundry-models-grok",
    "limits": "https://docs.x.ai/developers/models/grok-4.3",
    "pricing": "https://docs.x.ai/developers/models/grok-4.3"
  },
  "notes": [
    "Azure Foundry 将 Grok 4.3 列为支持 Chat Completions 和 Responses 的独立 preview deployment。",
    "xAI 直连请求在 prompt 达到 200K tokens 时整次请求使用高档费率；pricingCatalogEntry 启用该分档。此处为 xAI 官方单价，不代表已验证的 Azure 托管价格，绑定前需核实实际计费来源。"
  ]
}
