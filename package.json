{
  "name": "aoai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:dev": "vite --config admin-ui/vite.config.js",
    "build:admin": "vite build --config admin-ui/vite.config.js",
    "build": "npm run build:admin",
    "test:unit": "node --test test/*.test.js",
    "test:routes": "node test/run-all-routes.js",
    "test:cli:claude-code": "node test/cli/claude-code-smoke.js",
    "test:cli:codex": "node test/cli/codex-smoke.js",
    "test:real": "node test/run-all-real-routes.js",
    "test:latency": "node test/analyze-first-token-latency.js",
    "test:real:chat": "node test/routes/real-chat-completion.js",
    "test:real:response": "node test/routes/real-response.js",
    "test:real:openai-image": "node test/routes/real-openai-image.js",
    "test:real:blackforest-image": "node test/routes/real-blackforest-image.js"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/monitor-ingestion": "^1.2.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.35.4",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.14"
  }
}
